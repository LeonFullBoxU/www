--[[
================================================================================
  GLOBAL LEADERBOARD → GOOGLE SHEETS  ·  Roblox client tracker  ·  v2.1
================================================================================

  WHAT IT DOES
    • Scrapes the global leaderboard GUI every POLL_INTERVAL seconds (300 by
      default — the board only refreshes every ~5 min, so this is plenty and
      costs far less than event listeners on 100 rows).
    • Keeps the last known snapshot in memory (survives across re-executes via
      getgenv()).
    • Detects a leaderboard refresh by looking for ANY player whose level went
      up by at least MIN_GAIN_TO_TRIGGER since the previous snapshot.
    • Waits a short "settle" period, re-scrapes (the GUI fills in over a couple
      of seconds), then POSTs the board to the Apps Script web app.
    • Retries failed sends with backoff and re-queues them for the next cycle,
      so a dropped request never loses a refresh.

  CONSOLE CONTROLS (paste into the executor console while it runs)
    LeaderboardTracker.status()        -- print current state
    LeaderboardTracker.forceSend()     -- send a snapshot right now
    LeaderboardTracker.resetBaseline() -- forget the stored snapshot
    LeaderboardTracker.stop()          -- stop the loop

  SETUP
    1. Paste your web app URL into CONFIG.WEB_APP_URL below.
    2. Paste the same secret you set in Apps Script into CONFIG.SECRET.
    3. Execute. Leave the game open.
================================================================================
]]

--=============================================================================
-- CONFIGURATION
--=============================================================================

local CONFIG = {
	-- The /exec URL of your deployed Apps Script web app.
	WEB_APP_URL = "https://script.google.com/macros/s/AKfycbzuahV4SbmfNaQ5LNIDjFvxmfi2o5m5ht8VmBvIbqE_PbPyubeCoz6NAbDT7FgMTnor_Q/exec",

	-- Must match CONFIG.SHARED_SECRET in the Apps Script.
	SECRET = "LeonsLittleSecret32@",

	-- Path from `workspace` down to the ScrollingFrame holding the entries.
	GUI_PATH = { "LBFolder", "GlobalLeaderboard", "LeaderboardGUI", "Holder", "ScrollingFrame" },

	-- Names of the children inside each row (searched recursively).
	FIELD_RANK   = "Rank",
	FIELD_PLAYER = "Player",
	FIELD_LEVEL  = "Level",

	POLL_INTERVAL             = 300, -- seconds between scrapes (5 min)
	SETTLE_DELAY              = 5,   -- wait after detecting a change, then re-scrape
	MIN_GAIN_TO_TRIGGER       = 1,   -- a refresh = someone gained >= this many levels
	MIN_SECONDS_BETWEEN_SENDS = 90,  -- hard debounce so we never spam the web app
	HEARTBEAT_MINUTES         = 30,  -- keep-alive send if nothing changed (0 = off)

	-- The sheet only files a reading into a half-hour slot if it ARRIVES within
	-- a few minutes of that exact time (:00 / :30). Refresh-triggered sends land
	-- at arbitrary moments, so we also wake up exactly ON each boundary and send
	-- then — otherwise most slots would end up as "-".
	--
	-- The loop sleeps until whichever comes first: the next POLL_INTERVAL tick,
	-- or the next :00 / :30. That gives 5-minute refresh checks AND precise slot
	-- hits, without polling more often than asked.
	SLOT_ALIGNED_SENDS = true,
	SLOT_WINDOW_MINUTES = 5, -- send if we're this many minutes past :00 or :30
	                          -- (must stay under the Apps Script SLOT_TOLERANCE_MINUTES)

	MAX_RETRIES   = 3,   -- attempts per send
	RETRY_BACKOFF = 4,   -- seconds; multiplied by attempt number
	MAX_QUEUE     = 5,   -- max failed payloads held for a later retry

	-- The GUI streams its ~100 rows in over a second or two. Scraping mid-load
	-- yields a PARTIAL board, which would blank out every missing player on the
	-- sheet. Skip anything short and wait for the next cycle.
	MIN_PLAYERS_TO_SEND = 90,

	-- Replaying a very old snapshot is worse than dropping it: the sheet would
	-- file stale levels as if they were current. Bin queued payloads older than
	-- this instead of retrying them forever.
	MAX_QUEUE_AGE_SECONDS = 600,

	VERBOSE = true,      -- print every poll, not just interesting events
}

local CLIENT_VERSION = "2.1"

--=============================================================================
-- SERVICES / EXECUTOR PLUMBING
--=============================================================================

local HttpService = game:GetService("HttpService")

-- Different executors expose the HTTP function under different names.
local function resolveHttpRequest()
	local candidates = {}

	pcall(function() table.insert(candidates, request) end)
	pcall(function() table.insert(candidates, http_request) end)
	pcall(function() table.insert(candidates, syn and syn.request) end)
	pcall(function() table.insert(candidates, http and http.request) end)
	pcall(function() table.insert(candidates, fluxus and fluxus.request) end)
	pcall(function() table.insert(candidates, krnl and krnl.request) end)

	for _, fn in ipairs(candidates) do
		if type(fn) == "function" then
			return fn
		end
	end
	return nil
end

local httpRequest = resolveHttpRequest()

--=============================================================================
-- LOGGING
--=============================================================================

local function stamp()
	return os.date("%H:%M:%S")
end

local function log(fmt, ...)
	print(("[LB %s] "):format(stamp()) .. string.format(fmt, ...))
end

local function logv(fmt, ...)
	if CONFIG.VERBOSE then log(fmt, ...) end
end

local function logWarn(fmt, ...)
	warn(("[LB %s] "):format(stamp()) .. string.format(fmt, ...))
end

--=============================================================================
-- SINGLE-INSTANCE STATE
--   Stored on getgenv() so re-executing the script cleanly replaces the old
--   loop instead of running two copies, and so the baseline survives.
--=============================================================================

local genv = (type(getgenv) == "function") and getgenv() or _G
local previousInstance = genv.__LEADERBOARD_TRACKER

local STATE = {
	running       = true,
	frame         = nil,             -- cached ScrollingFrame
	baseline      = nil,             -- last confirmed snapshot
	queue         = {},              -- payloads awaiting retry
	polls         = 0,
	refreshes     = 0,
	slotSends     = 0,
	sends         = { ok = 0, failed = 0 },
	lastSendAt    = 0,
	lastRefreshAt = nil,
	lastSlotKey   = nil,             -- "YYYY-MM-DD HH:00" / ":30" already sent
	startedAt     = os.time(),
}

if previousInstance then
	previousInstance.running = false
	-- Inherit the old baseline so a re-execute doesn't lose a refresh window.
	STATE.baseline = previousInstance.baseline
	-- Disconnect anything a v3 (event-driven) instance may have left behind.
	for _, conn in ipairs(previousInstance.connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	log("Previous tracker instance stopped; baseline carried over.")
end

genv.__LEADERBOARD_TRACKER = STATE

--=============================================================================
-- PARSING HELPERS
--=============================================================================

local NUMBER_SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }

--- Trim + collapse whitespace, strip zero-width junk.
local function cleanText(value)
	if value == nil then return nil end
	local s = tostring(value)
	s = s:gsub("[\226\128\139\194\160]", " ")    -- zero-width space / nbsp
	s = s:gsub("%s+", " ")
	s = s:match("^%s*(.-)%s*$")
	if s == "" then return nil end
	return s
end

--- Pull a number out of arbitrary label text: "#12", "Level 1,340", "2.4K".
local function parseNumber(value)
	if type(value) == "number" then return math.floor(value + 0.5) end
	local s = cleanText(value)
	if not s then return nil end
	s = s:gsub(",", ""):gsub("%s", "")
	local digits, suffix = s:match("(%-?%d+%.?%d*)([KkMmBbTt]?)")
	if not digits then return nil end
	local n = tonumber(digits)
	if not n then return nil end
	if suffix and suffix ~= "" then
		n = n * (NUMBER_SUFFIX[suffix:upper()] or 1)
	end
	return math.floor(n + 0.5)
end

--- Read the display text of a named descendant, whatever type it happens to be.
local function readField(row, fieldName)
	local obj = row:FindFirstChild(fieldName, true)
	if not obj then return nil end

	-- TextLabel / TextButton / TextBox
	local ok, text = pcall(function()
		return obj.ContentText ~= nil and obj.ContentText or obj.Text
	end)
	if ok and text ~= nil and text ~= "" then return text end

	-- StringValue / IntValue / NumberValue
	local okV, value = pcall(function() return obj.Value end)
	if okV and value ~= nil then return value end

	return nil
end

--=============================================================================
-- SCRAPING
--=============================================================================

--- Locate (and cache) the ScrollingFrame. Re-resolves if the GUI was rebuilt.
local function resolveFrame()
	local cached = STATE.frame
	if cached and cached.Parent and cached:IsDescendantOf(game) then
		return cached
	end

	local node = workspace
	for _, name in ipairs(CONFIG.GUI_PATH) do
		node = node:FindFirstChild(name)
		if not node then
			return nil, ("leaderboard GUI not found (missing '%s')"):format(name)
		end
	end

	STATE.frame = node
	return node
end

--- Scrape the leaderboard into a snapshot table.
--  Snapshot = { time, list = {entry...}, byPlayer = {[name] = entry}, count }
local function scrape()
	local frame, err = resolveFrame()
	if not frame then return nil, err end

	local list, byPlayer = {}, {}

	for _, row in ipairs(frame:GetChildren()) do
		if row:IsA("GuiObject") then
			local player = cleanText(readField(row, CONFIG.FIELD_PLAYER))
			local level  = parseNumber(readField(row, CONFIG.FIELD_LEVEL))
			local rank   = parseNumber(readField(row, CONFIG.FIELD_RANK))

			-- A row only counts if we got a usable name AND a numeric level.
			if player and level then
				local entry = {
					rank   = rank or (#list + 1),
					player = player,
					level  = level,
				}

				local existing = byPlayer[player]
				if existing then
					-- Duplicate name on the board: keep the higher level.
					if level > existing.level then
						existing.level, existing.rank = level, entry.rank
					end
				else
					byPlayer[player] = entry
					table.insert(list, entry)
				end
			end
		end
	end

	if #list == 0 then
		return nil, "leaderboard is present but empty (still loading?)"
	end

	-- Guard against a half-rendered board. Sending 40 of 100 rows would make
	-- the other 60 look like they vanished and wreck their gains, so treat a
	-- short board as "not ready yet" rather than as data.
	if #list < CONFIG.MIN_PLAYERS_TO_SEND then
		return nil, ("board still loading (%d/%d rows)"):format(#list, CONFIG.MIN_PLAYERS_TO_SEND)
	end

	table.sort(list, function(a, b)
		if a.rank == b.rank then return a.level > b.level end
		return a.rank < b.rank
	end)

	return { time = os.time(), list = list, byPlayer = byPlayer, count = #list }
end

--=============================================================================
-- DIFFING
--=============================================================================

--- Compare two snapshots. Returns gainers, totalGained, newPlayers, dropped.
local function diff(previous, current)
	local gainers, totalGained, newPlayers = 0, 0, 0

	for player, entry in pairs(current.byPlayer) do
		local before = previous and previous.byPlayer[player]
		if before then
			local delta = entry.level - before.level
			if delta >= CONFIG.MIN_GAIN_TO_TRIGGER then
				gainers += 1
				totalGained += delta
			end
		else
			newPlayers += 1
		end
	end

	local dropped = 0
	if previous then
		for player in pairs(previous.byPlayer) do
			if not current.byPlayer[player] then dropped += 1 end
		end
	end

	return gainers, totalGained, newPlayers, dropped
end

--=============================================================================
-- PAYLOAD + SENDING
--=============================================================================

local function buildPayload(kind, previous, current)
	local entries = {}
	for _, entry in ipairs(current.list) do
		table.insert(entries, {
			Rank   = entry.rank,
			Player = entry.player,
			Level  = entry.level,
		})
	end

	local gainers, totalGained, newPlayers, dropped = diff(previous, current)

	return {
		secret        = CONFIG.SECRET,
		type          = kind,          -- "refresh" | "baseline" | "heartbeat" | "manual"
		clientVersion = CLIENT_VERSION,
		sentAt        = os.time(),
		sentAtIso     = os.date("!%Y-%m-%dT%H:%M:%SZ"),
		placeId       = game.PlaceId,
		jobId         = game.JobId,
		previousAt    = previous and previous.time or nil,
		entries       = entries,
		meta = {
			playersScanned = current.count,
			gainers        = gainers,
			totalGained    = totalGained,
			newPlayers     = newPlayers,
			droppedPlayers = dropped,
		},
	}
end

--- POST a payload with retries. Returns success, message.
local function send(payload)
	if not httpRequest then
		return false, "no HTTP request function available in this executor"
	end
	if CONFIG.WEB_APP_URL == "" or CONFIG.WEB_APP_URL:find("PASTE") then
		return false, "WEB_APP_URL is not configured"
	end

	local body = HttpService:JSONEncode(payload)

	for attempt = 1, CONFIG.MAX_RETRIES do
		local ok, response = pcall(httpRequest, {
			Url = CONFIG.WEB_APP_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
		})

		if ok and response then
			local code = response.StatusCode or response.status_code or 0
			if code >= 200 and code < 400 then
				STATE.sends.ok += 1
				STATE.lastSendAt = os.time()

				-- Try to read the server's reply for a nicer status line.
				local decoded
				pcall(function() decoded = HttpService:JSONDecode(response.Body or "") end)
				if type(decoded) == "table" and decoded.status == "error" then
					return false, "server error: " .. tostring(decoded.message)
				end
				if type(decoded) == "table" and decoded.day then
					local detail = decoded.hourLogged
						and (tostring(decoded.slot) .. " logged, day " .. tostring(decoded.day))
						or ("day " .. tostring(decoded.day) .. ", live update only")
					return true, detail
				end
				return true, "HTTP " .. code
			end

			logWarn("Send attempt %d/%d failed (HTTP %s)", attempt, CONFIG.MAX_RETRIES, tostring(code))
		else
			logWarn("Send attempt %d/%d errored: %s", attempt, CONFIG.MAX_RETRIES, tostring(response))
		end

		if attempt < CONFIG.MAX_RETRIES then
			task.wait(CONFIG.RETRY_BACKOFF * attempt)
		end
	end

	STATE.sends.failed += 1
	return false, "all retries exhausted"
end

--- Queue a payload that could not be delivered.
local function enqueue(payload)
	if #STATE.queue >= CONFIG.MAX_QUEUE then
		table.remove(STATE.queue, 1) -- drop the oldest
	end
	table.insert(STATE.queue, payload)
	logWarn("Payload queued for retry (%d in queue).", #STATE.queue)
end

--- Try to flush anything queued from earlier failures.
--- Payloads that have aged out are discarded rather than replayed — a stale
--- snapshot written as if it were current is worse than a gap.
local function flushQueue()
	while #STATE.queue > 0 do
		local queued = STATE.queue[1]
		local age = os.time() - (queued.sentAt or 0)
		if age > CONFIG.MAX_QUEUE_AGE_SECONDS then
			table.remove(STATE.queue, 1)
			logWarn("Dropped a queued payload (%ds old — too stale to replay). %d left.",
				age, #STATE.queue)
		else
			local ok, message = send(queued)
			if not ok then
				logWarn("Queued payload still failing (%s); will try again next cycle.", message)
				return
			end
			table.remove(STATE.queue, 1)
			log("Queued payload delivered (%s). %d left.", message, #STATE.queue)
		end
	end
end

--=============================================================================
-- MAIN CYCLE
--=============================================================================

--- Identity of the half-hour slot we're currently inside, e.g. "2026-08-18 14:30".
--- Returns nil if we're past the window where the server would still accept it.
local function currentSlotKey()
	local t = os.date("*t")
	local minutesIntoSlot = t.min % 30
	if minutesIntoSlot > CONFIG.SLOT_WINDOW_MINUTES then return nil end
	return ("%04d-%02d-%02d %02d:%02d"):format(
		t.year, t.month, t.day, t.hour, (t.min < 30) and 0 or 30)
end

--- Seconds until the next :00 / :30 boundary (plus a small margin so we land
--- just after it, never a hair before).
local function secondsUntilNextSlot()
	local t = os.date("*t")
	local secondsIntoSlot = (t.min % 30) * 60 + t.sec
	return (30 * 60) - secondsIntoSlot + 2
end

--- How long to sleep before the next cycle: whichever comes first, the normal
--- poll interval or the next slot boundary. Keeps 5-minute refresh checks while
--- still landing precisely on every :00 / :30.
local function nextSleepSeconds()
	if not CONFIG.SLOT_ALIGNED_SENDS then return CONFIG.POLL_INTERVAL end
	return math.max(math.min(CONFIG.POLL_INTERVAL, secondsUntilNextSlot()), 5)
end

--- Handle one poll. Returns a short human-readable status string.
local function poll()
	STATE.polls += 1

	local current, err = scrape()
	if not current then
		return "skipped · " .. tostring(err)
	end

	-- Slot-aligned send: make sure a payload lands inside each :00 / :30
	-- window so the sheet can file it under the exact slot. This bypasses the
	-- normal debounce, since missing the window means losing that slot.
	if CONFIG.SLOT_ALIGNED_SENDS and STATE.baseline then
		local slotKey = currentSlotKey()
		if slotKey and slotKey ~= STATE.lastSlotKey then
			STATE.lastSlotKey = slotKey
			STATE.slotSends += 1
			local ok, message = send(buildPayload("slot", STATE.baseline, current))
			STATE.baseline = current
			if ok then
				return ("slot %s sent · %d players · %s"):format(slotKey:sub(12), current.count, message)
			end
			logWarn("Slot send failed: %s", message)
			return ("slot %s send failed"):format(slotKey:sub(12))
		end
	end

	-- First run: establish the baseline and tell the server about it, so the
	-- sheet has a starting point even before the first refresh.
	if not STATE.baseline then
		STATE.baseline = current
		local ok, message = send(buildPayload("baseline", nil, current))
		if not ok then logWarn("Baseline send failed: %s", message) end
		return ("baseline set · %d players"):format(current.count)
	end

	local gainers, totalGained = diff(STATE.baseline, current)

	if gainers == 0 then
		-- No refresh. Optionally send a heartbeat so Live LB / Status stay fresh.
		local since = os.time() - STATE.lastSendAt
		if CONFIG.HEARTBEAT_MINUTES > 0 and since >= CONFIG.HEARTBEAT_MINUTES * 60 then
			local ok = send(buildPayload("heartbeat", STATE.baseline, current))
			if ok then return ("no change · heartbeat sent (%d players)"):format(current.count) end
		end
		return ("no change · %d players"):format(current.count)
	end

	-- Debounce: never fire two refreshes back to back.
	if os.time() - STATE.lastSendAt < CONFIG.MIN_SECONDS_BETWEEN_SENDS then
		return ("change detected but debounced (%ds since last send)"):format(os.time() - STATE.lastSendAt)
	end

	log("Refresh detected: %d players gained %d levels. Settling for %ds...",
		gainers, totalGained, CONFIG.SETTLE_DELAY)

	-- The GUI populates over a second or two. Re-scrape after settling so we
	-- capture the finished board rather than a half-updated one.
	task.wait(CONFIG.SETTLE_DELAY)
	local settled = scrape()
	if settled then current = settled end

	local previous = STATE.baseline
	local payload = buildPayload("refresh", previous, current)

	-- Advance the baseline immediately: even if the send fails, the next poll
	-- must not re-report the same refresh (the payload is queued instead).
	STATE.baseline = current
	STATE.refreshes += 1
	STATE.lastRefreshAt = os.time()

	local ok, message = send(payload)
	if ok then
		return ("REFRESH #%d sent · %d gainers · +%d levels · %s")
			:format(STATE.refreshes, payload.meta.gainers, payload.meta.totalGained, message)
	end

	enqueue(payload)
	return ("REFRESH #%d detected but send failed (%s) · queued")
		:format(STATE.refreshes, message)
end

--=============================================================================
-- PUBLIC CONSOLE API
--=============================================================================

genv.LeaderboardTracker = {
	stop = function()
		STATE.running = false
		log("Tracker stopped by user.")
	end,

	status = function()
		local uptime = os.time() - STATE.startedAt
		log("STATUS · uptime %dm %ds · polls %d · refreshes %d · slot sends %d · sends ok/fail %d/%d · queue %d",
			math.floor(uptime / 60), uptime % 60, STATE.polls, STATE.refreshes, STATE.slotSends,
			STATE.sends.ok, STATE.sends.failed, #STATE.queue)
		if STATE.baseline then
			log("  baseline: %d players, captured %ds ago",
				STATE.baseline.count, os.time() - STATE.baseline.time)
		else
			log("  baseline: not set yet")
		end
	end,

	forceSend = function()
		task.spawn(function()
			local current, err = scrape()
			if not current then
				logWarn("forceSend failed: %s", tostring(err))
				return
			end
			local ok, message = send(buildPayload("manual", STATE.baseline, current))
			STATE.baseline = current
			log("forceSend: %s (%s)", ok and "delivered" or "failed", message)
		end)
	end,

	resetBaseline = function()
		STATE.baseline = nil
		log("Baseline cleared; next poll will re-establish it.")
	end,
}

--=============================================================================
-- BOOT
--=============================================================================

task.spawn(function()
	log("=====================================================")
	log(" Leaderboard Tracker v%s starting", CLIENT_VERSION)
	log(" Poll every %ds · refresh = any player +%d level(s)", CONFIG.POLL_INTERVAL, CONFIG.MIN_GAIN_TO_TRIGGER)
	if CONFIG.SLOT_ALIGNED_SENDS then
		log(" Slot-aligned sends ON · loop also wakes exactly on each :00 / :30")
	end
	log(" Console API: LeaderboardTracker.status() / .forceSend() / .stop()")
	log("=====================================================")

	if not httpRequest then
		logWarn("No HTTP function found (request / syn.request / http_request).")
		logWarn("The tracker will keep scraping but cannot upload. Use a compatible executor.")
	end

	local frame, err = resolveFrame()
	if frame then
		log("Leaderboard GUI found: %s", frame:GetFullName())
	else
		logWarn("%s - will keep retrying every %ds.", tostring(err), CONFIG.POLL_INTERVAL)
	end

	while STATE.running and genv.__LEADERBOARD_TRACKER == STATE do
		-- Retry anything that failed earlier before doing new work.
		if #STATE.queue > 0 then flushQueue() end

		local ok, result = pcall(poll)
		if ok then
			if result:find("REFRESH") or result:find("baseline") or not result:find("no change") then
				log("%s", result)                    -- always show interesting events
			else
				logv("Poll #%d · %s", STATE.polls, result)
			end
		else
			logWarn("Poll error: %s", tostring(result))
		end

		task.wait(nextSleepSeconds())
	end

	log("Tracker loop ended.")
end)
